[Unit]
Description=Sonar audio mixer backend
After=pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
WorkingDirectory=@REPO@
# the native binary, or the jar with small-app JVM flags: install/toolchain.sh picks
ExecStart=@EXEC@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
